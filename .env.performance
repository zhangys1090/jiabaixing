# 家百星 V5.0 性能基线配置
# 此文件定义了生产环境的性能指标阈值和基线值

# ═══════════════════════════════════════════════════════════
# 响应时间基线（毫秒）
# ═══════════════════════════════════════════════════════════

# API 请求平均响应时间阈值
PERF_RESPONSE_TIME_WARN=3000
PERF_RESPONSE_TIME_CRITICAL=10000

# LLM 调用响应时间阈值
PERF_LLM_RESPONSE_TIME_WARN=5000
PERF_LLM_RESPONSE_TIME_CRITICAL=30000

# ═══════════════════════════════════════════════════════════
# 内存基线（MB）
# ═══════════════════════════════════════════════════════════

# 堆内存使用警告阈值
PERF_MEMORY_WARN=512
PERF_MEMORY_CRITICAL=1024

# RSS 内存使用警告阈值
PERF_RSS_WARN=768
PERF_RSS_CRITICAL=1536

# ═══════════════════════════════════════════════════════════
# 错误率基线
# ═══════════════════════════════════════════════════════════

# 全局错误率警告阈值（百分比）
PERF_ERROR_RATE_WARN=5
PERF_ERROR_RATE_CRITICAL=10

# LLM 调用失败率警告阈值
PERF_LLM_ERROR_RATE_WARN=10
PERF_LLM_ERROR_RATE_CRITICAL=25

# ═══════════════════════════════════════════════════════════
# 吞吐量基线
# ═══════════════════════════════════════════════════════════

# 最小请求吞吐量（请求/秒）
PERF_MIN_THROUGHPUT=1

# WebSocket 并发连接数上限
PERF_MAX_WS_CONNECTIONS=100

# ═══════════════════════════════════════════════════════════
# 监控配置
# ═══════════════════════════════════════════════════════════

# 指标采集间隔（毫秒）
PERF_COLLECT_INTERVAL=60000

# 指标保留时间（毫秒）
PERF_RETENTION_TIME=3600000

# 同类型告警冷却时间（毫秒）
PERF_ALERT_COOLDOWN=300000
