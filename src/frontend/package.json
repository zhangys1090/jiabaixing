{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:3111",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sentry/react": "^10.48.0",
    "@sentry/tracing": "^7.120.4",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "zustand": "^5.0.13"
  },
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "set NODE_OPTIONS=--no-deprecation && craco start",
    "build": "set NODE_OPTIONS=--no-deprecation && craco build",
    "build:fast": "set NODE_ENV=production&& set NODE_OPTIONS=--no-deprecation && craco build",
    "test": "craco test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lighthouse": "lhci autorun",
    "eject": "react-scripts eject",
    "analyze": "npm run build && npx source-map-explorer 'build/static/js/*.js'",
    "electron": "electron .",
    "electron:dev": "set ELECTRON_START_URL=http://localhost:3100 && electron ."
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "electron": "^41.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "lighthouse-ci": "^1.13.1",
    "prettier": "^3.8.2"
  }
}
