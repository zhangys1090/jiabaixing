# 家百星系统环境变量配置
# 复制此文件为 .env 并根据实际情况修改配置值

# ======================
# 应用基础配置
# ======================
NODE_ENV=development
PORT=3000
HOST=localhost
APP_NAME=jiabaixing
APP_VERSION=5.0.0
# Agent 后端：python（V5.0 真后端，默认）；local（TS 本地回退，已废弃）
AGENT_BACKEND=python

# ======================
# LLM 多模型配置（v5 Harness 架构）
# ======================

# --- 小米 MiMo（主模型，OpenAI 兼容接口）---
# https://token-plan-cn.xiaomimimo.com/v1
XIAOMI_API_KEY=your_xiaomi_api_key_here
XIAOMI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
XIAOMI_MODEL=mimo-v2.5-pro

# --- DeepSeek V4 Flash（备用降级模型，具备原生 Agent 能力） ---
# V4 Flash 具备原生 Agent 能力（TerminalBench 82.7, DeepSWE 54.4），
# 系统将自动检测并启用轻编排模式：放宽 FC 轮数、跳过深度验证、全量工具注册。
# 若需关闭此行为，设置 AGENT_NATIVE_FORCE_DISABLE=true
DEEPSEEK_API_KEY=your_deepseek_api_key_here
LLM_MODEL=deepseek-v4-flash
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_API_KEY=your_deepseek_api_key_here
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_REASONING_EFFORT=high

# --- Embedding 模型（需支持 /v1/embeddings 端点的提供商）---
# DeepSeek 不提供 embedding API，需单独配置提供商
# 推荐选项：
#   硅基流动（免费额度）: EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1  EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
#   智谱: EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4  EMBEDDING_MODEL=embedding-3
#   OpenAI: EMBEDDING_BASE_URL=https://api.openai.com/v1  EMBEDDING_MODEL=text-embedding-3-small
# 未配置时自动降级到 hash-based 向量（关键词级匹配，无语义理解）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- 本地 LLM.Server（降级模型，DeepSeek 不可用时回退） ---
LLM_SERVER_MODEL=qwen2.5:3b
LLM_SERVER_BASE_URL=http://127.0.0.1:8001/v1
LLM_SERVER_API_KEY=not-required

# --- 智谱 GLM（备用降级模型） ---
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.5-air

# ======================
# 服务器配置
# ======================
API_PORT=3111

# ======================
# 日志系统配置
# ======================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=10
LOG_CONSOLE=true
LOG_FILE=true
LOG_AUDIT=true

# ======================
# 安全配置
# ======================
DASHBOARD_SECRET_KEY=your_dashboard_secret_key_here
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
CORS_ORIGIN=*
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100

# ======================
# 文件存储配置
# ======================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10mb
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# ======================
# 缓存配置
# ======================
CACHE_TTL=3600
CACHE_ENABLED=true

# ======================
# 网络搜索配置
# ======================

# --- Tavily 搜索（主搜索提供商，专为 AI Agent 设计）---
TAVILY_API_KEY=your_tavily_api_key_here

# --- SearXNG 搜索（自托管隐私搜索引擎）---
SEARXNG_BASE_URL=http://localhost:8888

# --- Brave 搜索（高质量商业搜索 API）---
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# ======================
# 进化引擎配置
# ======================
ENABLE_AUTO_OPTIMIZE=true
