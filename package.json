{
  "name": "jiabaixing",
  "version": "5.0.0",
  "description": "Jiabaixing V5.0 — Harness Agent Framework 六维管控智能体系统",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "dependencies": {
    "@nut-tree/nut-js": "3.1.2",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "1.8.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-fetch": "^2.6.11",
    "@types/uuid": "10.0.0",
    "@types/ws": "^8.18.1",
    "axios": "1.16.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "chromadb": "^1.10.5",
    "compression": "1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "fast-glob": "3.3.3",
    "fs-extra": "^11.3.4",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^2.7.0",
    "node-record-lpcm16": "^1.0.1",
    "playwright": "^1.59.1",
    "screenshot-desktop": "1.15.4",
    "uuid": "14.0.0",
    "winston": "^3.19.0",
    "ws": "8.20.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/screenshot-desktop": "1.15.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "start": "node kill-port.mjs && concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "fix:native": "npm rebuild better-sqlite3",
    "postinstall": "npm rebuild better-sqlite3 || node -e \"console.warn('[postinstall] better-sqlite3 rebuild skipped; run npm run fix:native if startup fails')\"",
    "start:backend": "set CONSOLE_LOG_LEVEL=warn && ts-node --transpileOnly -r dotenv/config src/main.ts",
    "start:frontend": "npm start --prefix src/frontend",
    "start:main": "ts-node -r dotenv/config src/main.ts",
    "start:full": "concurrently --kill-others-on-fail \"npm run start:backend\" \"npm run start:frontend\"",
    "cli": "set CONSOLE_LOG_LEVEL=warn&& ts-node --transpileOnly -r dotenv/config src/cli.ts",
    "daemon": "set CONSOLE_LOG_LEVEL=warn&& ts-node --transpileOnly -r dotenv/config src/cli.ts daemon",
    "build": "tsc",
    "build:fast": "tsc --project tsconfig.fast.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration",
    "test:e2e": "cd tests/e2e && npx cypress run",
    "lint": "eslint",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "lint:fix": "eslint --fix",
    "prepare": "node scripts/pre-commit.js || true",
    "precommit": "node scripts/pre-commit.js",
    "check": "npm run lint && npm run format:check && npm run test",
    "check:all": "npm run lint && npm run format:check && npm run test:coverage && npm run build",
    "dev": "nodemon",
    "dev:watch": "nodemon --watch src",
    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix",
    "dep:audit": "node scripts/dependency-audit.js",
    "dep:update": "npm update && npm audit fix",
    "dep:outdated": "npm outdated",
    "dep:clean": "rm -rf node_modules package-lock.json && npm install",
    "log:analyze": "ts-node -r dotenv/config src/utils/log-analyzer-cli.ts",
    "log:report": "ts-node -r dotenv/config src/utils/log-analyzer-cli.ts --report",
    "log:query": "ts-node -r dotenv/config src/utils/log-analyzer-cli.ts --query",
    "log:clean": "find logs -name '*.log' -mtime +30 -delete",
    "eval": "node -r dotenv/config -r ts-node/register scripts/runEval.ts"
  },
  "keywords": [
    "ai",
    "assistant",
    "agent",
    "harness"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.x"
  }
}
