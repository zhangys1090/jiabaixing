# 依赖版本锁定策略
# 确保所有环境使用完全一致的依赖版本

# 严格模式：使用 package-lock.json 中的确切版本
save-exact=true
save-prefix=

# 网络配置
registry=https://registry.npmmirror.com
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# 安全配置
audit=true
ignore-scripts=false

# 性能优化
prefer-offline=true
maxsockets=10

# 日志配置
loglevel=notice
